{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EcoFinca",
  "version": "1.0.0",
  "identifier": "com.ecofinca.simulador",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EcoFinca · Simulador de finca cafetera sostenible",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Simulador educativo de producción cafetera sostenible",
    "longDescription": "EcoFinca es un simulador educativo en el que administras una finca cafetera colombiana de cinco hectáreas. Cada decisión sobre el suelo, el agua, los fertilizantes y las plagas afecta la productividad, la rentabilidad y la sostenibilidad del ecosistema.",
    "copyright": "© 2026 EcoFinca",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "education"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
